{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["./apps/api/node_modules/@types", "./node_modules/@types"]
  },
  "include": ["packages/shared/scripts/**/*.ts", "packages/shared/src/**/*.ts"]
}
