datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  MEMBER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  SEASONAL
  FREELANCE
  INTERNSHIP
  APPRENTICESHIP
  PER_DIEM
  VOLUNTEER
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewType {
  HR_SCREENING
  TECHNICAL
  CULTURE_FIT
  FINAL_ROUND
  ASSESSMENT
}

enum InterviewFormat {
  MEET
  ZOOM
  TEAMS
  OFFICE
}

enum WorkplaceType {
  ON_SITE
  HYBRID
  REMOTE
  FIELD
}

enum ExperienceLevel {
  INTERN
  ENTRY_LEVEL
  JUNIOR
  MID_LEVEL
  SENIOR_LEVEL
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum InviteStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum EmailTemplateType {
  APPLICATION_CONFIRMATION
  INTERVIEW_INVITATION
  REJECTION
  OFFER
  CUSTOM
}

enum EmailFlowKey {
  APPLICATION_RECEIVED
  INTERVIEW_SCHEDULED
  APPLICATION_REJECTED
  APPLICATION_OFFER
}

enum EmailDeliveryStatus {
  SENT
  SIMULATED
  FAILED
}

enum EmailScope {
  SYSTEM
  ORGANIZATION
}

enum SourcingChannel {
  LINKEDIN
  INDEED
  GOOGLE_JOBS
  CAREER_SITE
  REFERRAL
  DIRECT
  HANDSHAKE
  EMAIL
  WE_WORK_REMOTELY
  STACK_OVERFLOW
  TWITTER_X
  REDDIT
  GLASSDOOR
  AGENCY
  FACEBOOK
  OTHER
}

enum ActivityType {
  APPLIED
  STAGE_CHANGED
  EMAIL_SENT
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  SCORECARD_SUBMITTED
  NOTE_ADDED
}

enum WebhookEventType {
  DLQ_ALERT
  ORPHAN_SPIKE
  JOB_POSTED
}

enum WebhookProviderType {
  TELEGRAM
  DISCORD
  GENERIC
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  OPENROUTER
  OPENAI_COMPATIBLE
}

model Organization {
  id               String                       @id @default(uuid())
  name             String
  slug             String                       @unique
  ownerId          String
  logoObjectKey    String?
  logoMimeType     String?
  logoUpdatedAt    DateTime?
  defaultLanguage  String                       @default("vi")
  timezone         String                       @default("Asia/Ho_Chi_Minh")
  dateFormat       String                       @default("DD/MM/YYYY")
  timeFormat       String                       @default("24H")
  nameDisplayOrder String                       @default("LAST_FIRST")
  defaultCurrency  String                       @default("VND")
  auditLogRetentionDays Int?
  owner            User                         @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  jobs             Job[]
  candidates       Candidate[]
  applications     Application[]
  interviews       Interview[]
  trackingClicks   TrackingClick[]
  inviteLinks      InviteLink[]
  inviteLinkUsages InviteLinkUsage[]
  members          OrganizationMember[]
  emailTemplates   EmailTemplate[]
  emailFlows       EmailFlowConfig[]
  emailSettings    EmailSetting?
  emailLogs        EmailLog[]
  activityLogs     ActivityLog[]
  documents        CandidateDocument[]
  trackingLinks    TrackingLink[]
  webhookSettings  OrganizationWebhookSetting[]
  aiSetting        OrganizationAiSetting?
  rolePermissions  OrganizationRolePermission[]
  auditLogs        OrganizationAuditLog[]
  applicationNotes ApplicationNote[]
  candidateNotes   CandidateNote[]
  pipelineStages   PipelineStage[]
  storedFiles      StoredFile[]
  outboxEvents     OutboxEvent[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  @@index([ownerId])
  @@map("organization")
}

model User {
  id                 String                 @id @default(uuid())
  email              String                 @unique
  firstName          String                 @default("")
  lastName           String                 @default("")
  password           String?
  avatarUrl          String?
  avatarSource       String                 @default("NONE")
  avatarObjectKey    String?
  avatarMimeType     String?
  avatarUpdatedAt    DateTime?
  preferredLanguage  String?
  preferredTimezone  String?
  tokenVersion       Int                    @default(0)
  ownedOrganizations Organization[]         @relation("OrganizationOwner")
  jobs               Job[]
  inviteLinks        InviteLink[]
  inviteLinkUsages   InviteLinkUsage[]
  trackingLinks      TrackingLink[]
  assignedInterviews Interview[]            @relation("InterviewAssignee")
  memberships        OrganizationMember[]
  auditLogs          OrganizationAuditLog[]
  sessions           UserSession[]
  securityLogs       UserSecurityLog[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  @@map("user")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @default(MEMBER)
  lastAccessedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([userId, lastAccessedAt])
  @@map("organization_member")
}

model OrganizationRolePermission {
  id             String       @id @default(uuid())
  organizationId String
  role           Role
  permission     String
  granted        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role, permission])
  @@index([organizationId])
  @@map("organization_role_permission")
}

model InviteLink {
  id             String            @id @default(uuid())
  token          String            @unique
  role           Role              @default(MEMBER)
  invitedEmail   String?
  expiresAt      DateTime?
  maxUses        Int?
  usesCount      Int               @default(0)
  status         InviteStatus      @default(ACTIVE)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  usages         InviteLinkUsage[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, invitedEmail, status])
  @@map("invite_link")
}

model InviteLinkUsage {
  id                String       @id @default(uuid())
  inviteLinkId      String
  inviteLink        InviteLink   @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmailSnapshot String
  usedAt            DateTime     @default(now())

  @@index([inviteLinkId, usedAt])
  @@index([organizationId, usedAt])
  @@map("invite_link_usage")
}

model Job {
  id              String           @id @default(uuid())
  title           String
  department      String
  location        String
  postalCode      String?
  experienceLevel     ExperienceLevel?
  workplace           WorkplaceType?
  type                JobType          @default(FULL_TIME)
  description         String
  applicationDeadline DateTime?        @db.Date
  startDate           DateTime?        @db.Date
  openings            Int              @default(1)
  salaryRange         String?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?          @db.VarChar(10)
  status          JobStatus        @default(PUBLISHED)
  applicationFormConfig Json?
  createdById     String?
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications    Application[]
  trackingLinks   TrackingLink[]
  pipelineStages  PipelineStage[]
  version         Int              @default(1)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId, deletedAt, status, createdAt])
  @@map("job")
}

model Candidate {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String?
  lastName       String?
  displayName    String?
  gender         Gender?
  dateOfBirth    DateTime?
  email          String
  phone          String?
  resumeUrl      String?
  resumeFileName String?
  resumeFileSize Int?
  resumeMimeType String?             @default("application/pdf")
  resumeFileId   String?
  resumeFile     StoredFile?         @relation(fields: [resumeFileId], references: [id], onDelete: SetNull)
  applications   Application[]
  emailLogs      EmailLog[]
  activityLogs   ActivityLog[]
  documents      CandidateDocument[]
  candidateNotes CandidateNote[]
  version        Int                 @default(1)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, deletedAt, createdAt])
  @@map("candidate")
}

model Application {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId            String
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage            ApplicationStage  @default(APPLIED)
  stageId          String?
  pipelineStage    PipelineStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  rejectionReason  String?
  rejectedAt       DateTime?
  matchScore       Int?
  resumeUrl        String?
  resumeFileName   String?
  resumeFileSize   Int?
  resumeMimeType   String?           @default("application/pdf")
  resumeFileId     String?
  resumeFile       StoredFile?       @relation(fields: [resumeFileId], references: [id], onDelete: SetNull)
  coverLetter      String?
  screeningAnswers Json?
  orderIndex       Int               @default(0)
  trackingLinkId   String?
  trackingLink     TrackingLink?     @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)
  sourceChannel    SourcingChannel   @default(DIRECT)
  sourceDetails    String?
  referrerDomain   String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  interviews       Interview[]
  emailLogs        EmailLog[]
  activityLogs     ActivityLog[]
  applicationNotes ApplicationNote[]
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([candidateId, jobId])
  @@index([organizationId, jobId])
  @@index([organizationId, candidateId])
  @@index([organizationId, stage])
  @@index([organizationId, stageId])
  @@index([organizationId, createdAt])
  @@index([organizationId, sourceChannel])
  @@index([organizationId, trackingLinkId])
  @@index([jobId, stage])
  @@index([candidateId])
  @@index([trackingLinkId])
  @@map("application")
}

model Interview {
  id              String          @id @default(uuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  type            InterviewType   @default(TECHNICAL)
  format          InterviewFormat @default(MEET)
  linkOrLocation  String
  interviewer     String
  interviewerId   String?
  interviewerUser User?           @relation("InterviewAssignee", fields: [interviewerId], references: [id], onDelete: SetNull)
  round           Int             @default(1)
  scorecard       Json?           @db.JsonB
  notes           String?
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([applicationId])
  @@index([organizationId, scheduledAt])
  @@index([interviewerId])
  @@map("interview")
}

model EmailTemplate {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           EmailTemplateType @default(CUSTOM)
  name           String
  subject        String
  body           String
  enabled        Boolean           @default(true)
  isSystem       Boolean           @default(false)
  variables      Json?             @db.JsonB
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  flowConfigs    EmailFlowConfig[]
  emailLogs      EmailLog[]

  @@index([organizationId, enabled])
  @@map("email_template")
}

model EmailFlowConfig {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flowKey        EmailFlowKey
  templateId     String?
  template       EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  enabled        Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, flowKey])
  @@index([organizationId])
  @@map("email_flow_config")
}

model EmailSetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String       @default("SIMULATED")
  fromName       String       @default("Recruitment Team")
  fromEmail      String       @default("careers@workspace.com")
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPass       String?
  resendApiKey   String?
  sendgridApiKey String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("email_setting")
}

model EmailLog {
  id             String              @id @default(uuid())
  scope          EmailScope          @default(ORGANIZATION)
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  candidateId    String?
  candidate      Candidate?          @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  applicationId  String?
  application    Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  templateId     String?
  template       EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName   String?
  senderId       String?
  senderName     String
  senderEmail    String
  recipientEmail String
  recipientName  String
  templateType   EmailTemplateType   @default(CUSTOM)
  subject        String
  body           String
  status         EmailDeliveryStatus @default(SENT)
  errorMessage   String?
  sentAt         DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, sentAt])
  @@index([candidateId, sentAt])
  @@index([applicationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([scope, createdAt])
  @@index([templateId])
  @@map("email_log")
}

model ActivityLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  type           ActivityType
  title          String
  description    String
  actorId        String?
  actorName      String
  actorRole      String?
  metadata       Json?        @db.JsonB
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([applicationId, createdAt])
  @@index([organizationId, candidateId, createdAt])
  @@index([organizationId, createdAt])
  @@index([candidateId])
  @@map("activity_log")
}

model CandidateDocument {
  id             String       @id @default(uuid())
  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  url            String
  size           Int?
  mimeType       String?      @default("application/pdf")
  type           String?      @default("Resume")
  storedFileId   String?
  storedFile     StoredFile?  @relation(fields: [storedFileId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([candidateId])
  @@index([organizationId])
  @@map("candidate_document")
}

model TrackingLink {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  token          String
  source         SourcingChannel @default(OTHER)
  customSource   String?
  jobId          String?
  job            Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  campaign       String?
  medium         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  clicksCount    Int             @default(0)
  isActive       Boolean         @default(true)
  createdById    String?
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  applications   Application[]
  clicks         TrackingClick[]
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, deletedAt, isActive])
  @@index([jobId])
  @@index([createdById])
  @@index([organizationId, isActive])
  @@map("tracking_link")
}

model TrackingClick {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackingLinkId String
  trackingLink   TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  referrer       String?
  referrerDomain String?
  ipHash         String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([trackingLinkId, createdAt])
  @@index([referrerDomain])
  @@map("tracking_click")
}

model OrganizationWebhookSetting {
  id             String              @id @default(uuid())
  organizationId String
  eventType      WebhookEventType
  provider       WebhookProviderType
  webhookUrl     String
  secretToken    String?
  chatId         String?
  isEnabled      Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdBy      String?
  updatedBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, eventType, provider])
  @@index([organizationId])
  @@map("organization_webhook_setting")
}

model OrganizationAuditLog {
  id                 String   @id @default(uuid())
  organizationId     String
  actorId            String?
  action             String
  resource           String
  targetId           String?
  targetLabel        String?
  actorNameSnapshot  String?
  actorEmailSnapshot String?
  changes            Json?    @db.JsonB
  metadata           Json?    @db.JsonB
  ipAddress          String?
  userAgent          String?
  requestId          String?
  createdAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, resource])
  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, targetId, createdAt])
  @@map("organization_audit_log")
}

model PlatformAuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String
  action         String
  resource       String
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@map("platform_audit_log")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("user_session")
}

model UserSecurityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  status    String   @default("SUCCESS")
  ipAddress String?
  userAgent String?
  requestId String?
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, action])
  @@map("user_security_log")
}

model ApplicationNote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId       String
  authorName     String
  authorRole     String
  content        String       @db.Text
  isEdited       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([applicationId, createdAt])
  @@map("application_note")
}

model CandidateNote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorId       String
  authorName     String
  authorRole     String
  content        String       @db.Text
  isEdited       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([candidateId, createdAt])
  @@map("candidate_note")
}

model PipelineStage {
  id             String           @id @default(uuid())
  organizationId String
  jobId          String?
  name           String
  category       ApplicationStage
  orderIndex     Int              @default(0)
  color          String?
  isTerminal     Boolean          @default(false)
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([organizationId, jobId, orderIndex])
  @@map("pipeline_stage")
}

model StoredFile {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objectKey      String       @unique
  bucket         String       @default("haihire-resumes")
  originalName   String
  mimeType       String
  sizeBytes      Int
  checksum       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  candidates         Candidate[]
  applications       Application[]
  candidateDocuments CandidateDocument[]

  @@index([organizationId, createdAt])
  @@map("stored_file")
}

model OutboxEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("outbox_event")
}

model NotificationPreference {
  organizationId     String
  userId             String
  applicationWebsite Boolean      @default(true)
  interviewWebsite   Boolean      @default(true)
  applicationEmail   Boolean      @default(false)
  interviewEmail     Boolean      @default(false)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("notification_preference")
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  kind           String
  resourceId     String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt])
  @@index([userId])
  @@map("notification")
}

model OrganizationAiSetting {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  provider        AiProvider
  modelId         String
  encryptedApiKey String?
  apiKeyLast4     String?
  baseUrl         String?
  isEnabled       Boolean      @default(true)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("organization_ai_setting")
}
