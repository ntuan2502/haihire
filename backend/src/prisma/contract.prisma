// use prisma-next

enum Role {
  HR
  ADMIN
  INTERVIEWER
  CANDIDATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  inviteCode  String       @unique
  users       User[]
  jobs        Job[]
  inviteLinks InviteLink[]
  createdAt   DateTime     @default(now())
  updatedAt   temporal.updatedAt()
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String
  password       String?
  avatarUrl      String?
  role           Role          @default(HR)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  jobs           Job[]
  inviteLinks    InviteLink[]
  createdAt      DateTime      @default(now())
  updatedAt      temporal.updatedAt()
}

model InviteLink {
  id             String       @id @default(uuid())
  token          String       @unique
  role           String       @default("Member")
  expiresAt      DateTime?
  maxUses        Int?
  usesCount      Int          @default(0)
  status         String       @default("active")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      temporal.updatedAt()
}

model Job {
  id              String        @id @default(uuid())
  title           String
  department      String
  location        String
  postalCode      String?
  experienceLevel String?
  workplace       String?
  type            JobType       @default(FULL_TIME)
  description     String
  requirements    String?
  salaryRange     String?
  status          JobStatus     @default(PUBLISHED)
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  applications    Application[]
  createdAt       DateTime      @default(now())
  updatedAt       temporal.updatedAt()
}

model Application {
  id             String           @id @default(uuid())
  jobId          String?
  job            Job?             @relation(fields: [jobId], references: [id])
  candidateName  String
  candidateEmail String
  candidatePhone String?
  stage          ApplicationStage @default(APPLIED)
  resumeUrl      String
  resumeFileName String
  resumeFileSize Int?
  resumeMimeType String?          @default("application/pdf")
  notes          String?
  orderIndex     Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      temporal.updatedAt()
}
