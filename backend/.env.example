# ==============================================================================
# ATS PLATFORM - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Note: Copy this file to .env and populate all values before starting the service.
# The backend applies strict fail-fast validation: if any of the required keys
# below are missing or secrets do not meet security length requirements,
# the process will terminate immediately upon startup (exit code 1).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# The port that the NestJS API server listens on (default: 3001)
PORT=3001

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL & PRISMA ORM)
# ------------------------------------------------------------------------------
# PostgreSQL connection string: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
# - Use 'localhost' when running NestJS directly on the host machine
# - Use 'postgres' when running NestJS inside Docker Compose network
DATABASE_URL="postgresql://haihire_user:haihire_password@localhost:5432/haihire_db?schema=public"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens (JWT)
# Requirement: Minimum 16 characters. Must be changed to a strong secret in production.
JWT_SECRET="haihire-platform-dev-jwt-secret-key-2026"

# Symmetric secret key used for AES-256-GCM encryption of sensitive data
# Requirement: Minimum 32 characters. Must be changed to a strong secret in production.
ENCRYPTION_SECRET="haihire-platform-dev-encryption-key-32-chars-2026"

# Default password used for pre-configured development demo seed accounts (Admin/Member)
DEMO_SEED_PASSWORD="dev-seed-password-2026"

# ------------------------------------------------------------------------------
# 4. CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed Frontend origins for CORS authorization.
# Note: Wildcard origin '*' or true is strictly disallowed when credentials are enabled.
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. MINIO S3-COMPATIBLE OBJECT STORAGE
# ------------------------------------------------------------------------------
# Hostname of the MinIO service ('localhost' on host machine, 'minio' in Docker Compose)
MINIO_ENDPOINT="localhost"

# S3 API service port for MinIO (standard: 9000)
MINIO_PORT=9000

# Whether to use SSL/HTTPS connection (true / false)
MINIO_USE_SSL="false"

# MinIO Root User / Access Key ID
MINIO_ACCESS_KEY="minioadmin"

# MinIO Root Password / Secret Access Key
MINIO_SECRET_KEY="minioadmin"

# Default bucket name for candidate resumes, avatars, and attachments
MINIO_BUCKET_NAME="haihire-resumes"

# Public URL used by clients to access and download uploaded files
MINIO_PUBLIC_URL="http://localhost:9000"

# ------------------------------------------------------------------------------
# 6. SYSTEM EMAIL CONFIGURATION (PLATFORM NOTIFICATIONS & INVITES)
# ------------------------------------------------------------------------------
# Provider used for system-level emails: 'SIMULATED' | 'SMTP' | 'RESEND' | 'SENDGRID'
SYSTEM_EMAIL_PROVIDER="SIMULATED"

# Display name for system sender
SYSTEM_EMAIL_FROM_NAME="HaiHire Platform"

# Sender email address for system messages
SYSTEM_EMAIL_FROM_EMAIL="noreply@haihire.internal"

# SMTP Server Settings (Required if SYSTEM_EMAIL_PROVIDER='SMTP')
SYSTEM_EMAIL_SMTP_HOST=""
SYSTEM_EMAIL_SMTP_PORT=587
SYSTEM_EMAIL_SMTP_USER=""
SYSTEM_EMAIL_SMTP_PASS=""

# Resend API Key (Required if SYSTEM_EMAIL_PROVIDER='RESEND')
SYSTEM_EMAIL_RESEND_API_KEY=""

# SendGrid API Key (Required if SYSTEM_EMAIL_PROVIDER='SENDGRID')
SYSTEM_EMAIL_SENDGRID_API_KEY=""

# ------------------------------------------------------------------------------
# 7. REDIS CONFIGURATION (CACHE & QUEUES)
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 8. MULTI-CHANNEL WEBHOOK NOTIFICATIONS (OPTIONAL GLOBAL FALLBACK)
# ------------------------------------------------------------------------------
# Provider: 'TELEGRAM' | 'DISCORD' | 'GENERIC' (leave empty to disable)
WEBHOOK_PROVIDER=""
# Target webhook URL or Telegram Bot API URL
WEBHOOK_URL=""
# Secret token for Generic Webhook HMAC signing (optional)
WEBHOOK_SECRET_TOKEN=""
# Chat ID for Telegram Bot notifications (required if WEBHOOK_PROVIDER='TELEGRAM')
WEBHOOK_CHAT_ID=""


