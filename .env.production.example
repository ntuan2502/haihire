# ==============================================================================
# HAIHIRE PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Production deployment template. Copy to `.env.production` on the server.
#
# SECURITY WARNING:
#   - File must have chmod 600 permissions.
#   - Never commit `.env.production` to git.
#   - Rotate secrets quarterly.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUCTION DEPLOYMENT METADATA
# ------------------------------------------------------------------------------
# Consumed by: Docker Compose (prod), CI/CD
GITHUB_REPOSITORY_OWNER="ntuan2502"
IMAGE_TAG="v1.0.0"

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & PORTS
# ------------------------------------------------------------------------------
NODE_ENV=production
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE & PRISMA ORM
# ------------------------------------------------------------------------------
POSTGRES_USER=haihire_prod_user
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=haihire_production
POSTGRES_PORT=5432
DATABASE_URL="postgresql://haihire_prod_user:<CHANGE_ME>@postgres:5432/haihire_production?schema=public"

# ------------------------------------------------------------------------------
# 4. VALKEY / REDIS
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME>

# ------------------------------------------------------------------------------
# 5. MINIO S3
# ------------------------------------------------------------------------------
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=<CHANGE_ME>
MINIO_SECRET_KEY=<CHANGE_ME>
MINIO_BUCKET_NAME="haihire-production-resumes"
MINIO_PUBLIC_URL="https://s3.yourcompany.com"

# ------------------------------------------------------------------------------
# 6. SECURITY SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET=<CHANGE_ME>
ENCRYPTION_SECRET=<CHANGE_ME>
DEMO_SEED_PASSWORD=<CHANGE_ME>

# ------------------------------------------------------------------------------
# 7. NETWORKING & ENDPOINTS
# ------------------------------------------------------------------------------
FRONTEND_URL="https://ats.yourcompany.com"
FRONTEND_API_URL="https://api.yourcompany.com"
INTERNAL_API_URL="http://backend:3001"
NEXT_PUBLIC_API_URL="https://api.yourcompany.com"
NEXT_PUBLIC_MINIO_URL="/haihire-production-resumes"

# ------------------------------------------------------------------------------
# 8. SYSTEM EMAIL
# ------------------------------------------------------------------------------
SYSTEM_EMAIL_PROVIDER="SMTP"
SYSTEM_EMAIL_FROM_NAME="HaiHire Production Team"
SYSTEM_EMAIL_FROM_EMAIL="careers@yourcompany.com"
SYSTEM_EMAIL_SMTP_HOST="smtp.sendgrid.net"
SYSTEM_EMAIL_SMTP_PORT=587
SYSTEM_EMAIL_SMTP_USER="apikey"
SYSTEM_EMAIL_SMTP_PASS=<CHANGE_ME>
SYSTEM_EMAIL_RESEND_API_KEY=""
SYSTEM_EMAIL_SENDGRID_API_KEY=<CHANGE_ME>

# ------------------------------------------------------------------------------
# 9. WEBHOOK NOTIFICATIONS
# ------------------------------------------------------------------------------
WEBHOOK_PROVIDER=""
WEBHOOK_URL=""
WEBHOOK_SECRET_TOKEN=""
WEBHOOK_CHAT_ID=""

# ------------------------------------------------------------------------------
# 10. PROMETHEUS PUSHGATEWAY
# ------------------------------------------------------------------------------
PUSHGATEWAY_PORT=9091
PUSHGATEWAY_URL="http://pushgateway:9091"
