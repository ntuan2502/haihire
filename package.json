{
  "name": "ats-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter ./backend --filter ./frontend --parallel run dev",
    "dev:backend": "pnpm --filter ./backend run dev",
    "dev:frontend": "pnpm --filter ./frontend run dev",
    "build": "pnpm --filter ./backend run build && pnpm --filter ./frontend run build",
    "lint": "pnpm --filter ./backend run lint && pnpm --filter ./frontend run lint",
    "test": "pnpm --filter ./backend run test",
    "seed": "pnpm --filter ./backend run seed",
    "contract:emit": "pnpm --filter ./backend run contract:emit",
    "check:i18n": "pnpm --filter ./frontend run check:i18n"
  }
}
