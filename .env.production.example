# ==============================================================================
# HAIHIRE PLATFORM - PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# Security Notice: NEVER commit actual production secrets to source control.
# Copy this file to .env.production on your secure production runner / host,
# populate with strong random values, and protect with chmod 600.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. GITHUB CONTAINER REGISTRY & IMMUTABLE RELEASE TAG
# ------------------------------------------------------------------------------
# Target GitHub repository owner / user / organization holding GHCR images (e.g. ntuan2502)
GITHUB_REPOSITORY_OWNER=ntuan2502

# Immutable image release tag (e.g. v1.0.0, v1.0.1, or commit sha-xxxxxxx)
# SECURITY & IMMUTABILITY MANDATE: NEVER use 'latest' in production deployment.
IMAGE_TAG=v1.0.0

# ------------------------------------------------------------------------------
# 1. NODE RUNTIME & PORTS
# ------------------------------------------------------------------------------
NODE_ENV=production
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 2. POSTGRESQL PRODUCTION DATABASE
# ------------------------------------------------------------------------------
POSTGRES_USER=haihire_prod_user
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_MIN_32_CHARS
POSTGRES_DB=haihire_production

# ------------------------------------------------------------------------------
# 3. REDIS DISTRIBUTED CACHE & QUEUE
# ------------------------------------------------------------------------------
# Generate: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_MIN_32_CHARS

# ------------------------------------------------------------------------------
# 4. S3 OBJECT STORAGE (MINIO / AWS S3)
# ------------------------------------------------------------------------------
# Generate: openssl rand -hex 16
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY_ID_PROD
# Generate: openssl rand -base64 32
MINIO_SECRET_KEY=CHANGE_ME_SECRET_KEY_PROD
MINIO_BUCKET_NAME=haihire-production-resumes
MINIO_PUBLIC_URL=https://s3.yourcompany.com

# ------------------------------------------------------------------------------
# 5. CRYPTOGRAPHIC SECRETS (STRICT SECURITY VALIDATION ENFORCED)
# ------------------------------------------------------------------------------
# Minimum 32 characters for JWT signing and token verification
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_KEY_AT_LEAST_32_CHARS_LONG_RANDOM

# Minimum 32 characters for AES-256-GCM symmetric encryption of credentials
# Generate: openssl rand -base64 48
ENCRYPTION_SECRET=CHANGE_ME_ENCRYPTION_SECRET_32_CHARS_LONG_RANDOM

# ------------------------------------------------------------------------------
# 6. CORS & PUBLIC URLS (STRICT ORIGIN ENFORCEMENT)
# ------------------------------------------------------------------------------
# Do NOT use wildcard '*'. Must match exact public domain for secure cookie authentication.
FRONTEND_URL=https://ats.yourcompany.com
FRONTEND_API_URL=https://api.yourcompany.com

# ------------------------------------------------------------------------------
# 7. SYSTEM EMAIL DISPATCH (PRODUCTION SMTP / RESEND / SENDGRID)
# ------------------------------------------------------------------------------
SYSTEM_EMAIL_PROVIDER=SMTP
SYSTEM_EMAIL_FROM_NAME="HaiHire Production Team"
SYSTEM_EMAIL_FROM_EMAIL=careers@yourcompany.com

# Required if SYSTEM_EMAIL_PROVIDER=SMTP
SYSTEM_EMAIL_SMTP_HOST=smtp.sendgrid.net
SYSTEM_EMAIL_SMTP_PORT=587
SYSTEM_EMAIL_SMTP_USER=apikey
SYSTEM_EMAIL_SMTP_PASS=CHANGE_ME_SMTP_PASSWORD

# Required if SYSTEM_EMAIL_PROVIDER=RESEND
SYSTEM_EMAIL_RESEND_API_KEY=

# Required if SYSTEM_EMAIL_PROVIDER=SENDGRID
SYSTEM_EMAIL_SENDGRID_API_KEY=

# ------------------------------------------------------------------------------
# 8. MULTI-CHANNEL WEBHOOK NOTIFICATIONS (OPTIONAL GLOBAL FALLBACK)
# ------------------------------------------------------------------------------
WEBHOOK_PROVIDER=
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=
WEBHOOK_CHAT_ID=

