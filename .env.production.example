# ==============================================================================
# HAIHIRE PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.production` on your production VPS and customize secrets.
# NEVER commit `.env.production` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONTAINER REGISTRY & GATEWAY PORT
# ------------------------------------------------------------------------------
GITHUB_REPOSITORY_OWNER="ntuan2502"
IMAGE_TAG="v1.0.0"
NODE_ENV=production
GATEWAY_PORT=8080

# ------------------------------------------------------------------------------
# 2. POSTGRESQL PRODUCTION DATABASE
# ------------------------------------------------------------------------------
POSTGRES_USER=haihire_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=haihire_production

# ------------------------------------------------------------------------------
# 3. VALKEY / REDIS PRODUCTION CACHE & QUEUE
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD="CHANGE_ME_STRONG_REDIS_PASSWORD"

# ------------------------------------------------------------------------------
# 4. MINIO PRODUCTION S3 OBJECT STORAGE
# ------------------------------------------------------------------------------
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="CHANGE_ME_MINIO_ACCESS_KEY_MIN_16_CHARS"
MINIO_SECRET_KEY="CHANGE_ME_MINIO_SECRET_KEY_MIN_32_CHARS"
MINIO_BUCKET_NAME="haihire-production-resumes"

# ------------------------------------------------------------------------------
# 5. SECURITY & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_ME_MIN_64_CHAR_RANDOM_JWT_SECRET"
ENCRYPTION_SECRET="CHANGE_ME_MIN_64_CHAR_RANDOM_ENCRYPTION_SECRET"
METRICS_TOKEN="CHANGE_ME_MIN_32_CHAR_RANDOM_METRICS_BEARER_TOKEN"

# ------------------------------------------------------------------------------
# 6. PUBLIC DOMAIN & SYSTEM EMAIL (SMTP)
# ------------------------------------------------------------------------------
FRONTEND_URL="https://ats.yourcompany.com"
SYSTEM_EMAIL_PROVIDER="SMTP"
SYSTEM_EMAIL_FROM_NAME="HaiHire Production"
SYSTEM_EMAIL_FROM_EMAIL="noreply@yourcompany.com"
SYSTEM_EMAIL_SMTP_HOST="smtp.yourcompany.com"
SYSTEM_EMAIL_SMTP_PORT=587
SYSTEM_EMAIL_SMTP_USER=""
SYSTEM_EMAIL_SMTP_PASS=""

# ==============================================================================
# OPTIONAL OVERRIDES (Uncomment in `.env.production` only when needed)
# ==============================================================================
# BACKEND_PORT=3001
# FRONTEND_PORT=3000
# DATABASE_URL=""
# INTERNAL_API_URL="http://api:3001"
# NEXT_PUBLIC_API_URL=""
# MINIO_PUBLIC_URL=""
# SYSTEM_EMAIL_RESEND_API_KEY=""
# SYSTEM_EMAIL_SENDGRID_API_KEY=""
# WEBHOOK_PROVIDER=""
# WEBHOOK_URL=""
# WEBHOOK_SECRET_TOKEN=""
# WEBHOOK_CHAT_ID=""
# AI_ALLOWED_INTERNAL_HOSTS=""
# PUSHGATEWAY_PORT=9091
# PUSHGATEWAY_URL="http://pushgateway:9091"
# BACKUP_DIR="./backups/production"
# BACKUP_RETENTION_DAYS=30
# BACKUP_RESTORE_DRILL="true"
# POSTGRES_CONTAINER="haihire-prod-postgres"
# MINIO_CONTAINER="haihire-prod-minio"
