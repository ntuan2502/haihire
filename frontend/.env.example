# NestJS Backend API Endpoint
# Leave empty in local/LAN development so browser requests route via Next.js proxy rewrites (/api).
# This allows any device on the local network (phones, tablets, laptops) to connect seamlessly.
# Only specify an explicit URL if connecting to an external/production API.
NEXT_PUBLIC_API_URL=""

# MinIO Endpoint for Candidate Resumes / Avatars (proxied via Next.js rewrite /ats-resumes)
NEXT_PUBLIC_MINIO_URL="/ats-resumes"
