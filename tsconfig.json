{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["./backend/node_modules/@types", "./node_modules/@types"]
  },
  "include": ["scripts/**/*.ts"]
}
