# ==============================================================================
# ATS PLATFORM - FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Note: Copy this file to .env in the frontend directory before running the app.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# The port that the Next.js server listens on (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 2. BACKEND API ENDPOINT (SERVER-SIDE COMMUNICATION)
# ------------------------------------------------------------------------------
# Backend API URL used during Server-Side Rendering (SSR), Server Actions, and Node.js.
# Communicates directly via internal network for minimal latency.
INTERNAL_API_URL="http://127.0.0.1:3001"

# ------------------------------------------------------------------------------
# 3. BACKEND API ENDPOINT (CLIENT-SIDE BROWSER COMMUNICATION)
# ------------------------------------------------------------------------------
# Public API URL for client-side browser requests:
# - Leave EMPTY ("") for local/LAN development so requests route via Next.js proxy rewrites (/api).
#   This allows devices on the local network (phones, tablets, laptops) to connect without CORS issues.
# - Specify a full URL (e.g., https://api.ats.example.com) if deploying frontend and backend to separate domains.
NEXT_PUBLIC_API_URL=""

# ------------------------------------------------------------------------------
# 4. MINIO OBJECT STORAGE PROXY / ASSETS
# ------------------------------------------------------------------------------
# Public path for candidate resumes and attachments:
# - Defaults to "/haihire-resumes" proxied via Next.js rewrites to MinIO on port 9000
NEXT_PUBLIC_MINIO_URL="/haihire-resumes"
