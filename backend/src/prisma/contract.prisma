// use prisma-next

enum Role {
  ADMIN
  MEMBER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewType {
  HR_SCREENING
  TECHNICAL
  CULTURE_FIT
  FINAL_ROUND
  ASSESSMENT
}

enum InterviewFormat {
  MEET
  ZOOM
  TEAMS
  OFFICE
}

enum WorkplaceType {
  ON_SITE
  HYBRID
  REMOTE
}

enum ExperienceLevel {
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR_LEVEL
  LEAD
  EXECUTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum InviteStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum EmailTemplateType {
  APPLICATION_CONFIRMATION
  INTERVIEW_INVITATION
  REJECTION
  OFFER
  CUSTOM
}

enum EmailDeliveryStatus {
  SENT
  SIMULATED
  FAILED
}

enum EmailScope {
  SYSTEM
  ORGANIZATION
}

enum ActivityType {
  APPLIED
  STAGE_CHANGED
  EMAIL_SENT
  INTERVIEW_SCHEDULED
  INTERVIEW_UPDATED
  SCORECARD_SUBMITTED
  NOTE_ADDED
}

model Organization {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  ownerId     String?
  users       User[]
  jobs        Job[]
  candidates  Candidate[]
  inviteLinks InviteLink[]
  members     OrganizationMember[]
  emailTemplates EmailTemplate[]
  emailSettings  EmailSetting?
  emailLogs      EmailLog[]
  activityLogs   ActivityLog[]
  documents      CandidateDocument[]
  createdAt   DateTime             @default(now())
  updatedAt   temporal.updatedAt()
}

model User {
  id             String               @id @default(uuid())
  email          String               @unique
  name           String
  password       String?
  avatarUrl      String?
  role           Role                 @default(MEMBER)
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  jobs           Job[]
  inviteLinks    InviteLink[]
  memberships    OrganizationMember[]
  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId, userId])
}

model InviteLink {
  id             String       @id @default(uuid())
  token          String       @unique
  role           Role         @default(MEMBER)
  expiresAt      DateTime?
  maxUses        Int?
  usesCount      Int          @default(0)
  status         InviteStatus @default(ACTIVE)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      temporal.updatedAt()
}

model Job {
  id              String        @id @default(uuid())
  title           String
  department      String
  location        String
  postalCode      String?
  experienceLevel ExperienceLevel?
  workplace       WorkplaceType?
  type            JobType       @default(FULL_TIME)
  description     String
  requirements    String?
  salaryRange     String?
  status          JobStatus     @default(PUBLISHED)
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  applications    Application[]
  createdAt       DateTime      @default(now())
  updatedAt       temporal.updatedAt()

  @@index([organizationId, status])
}

model Candidate {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  firstName      String?
  lastName       String?
  gender         Gender?
  dateOfBirth    DateTime?
  email          String
  phone          String?
  notes          String?
  resumeUrl      String?
  resumeFileName String?
  resumeFileSize Int?
  resumeMimeType String?       @default("application/pdf")
  applications   Application[]
  emailLogs      EmailLog[]
  activityLogs   ActivityLog[]
  documents      CandidateDocument[]
  createdAt      DateTime      @default(now())
  updatedAt      temporal.updatedAt()

  @@unique([organizationId, email])
}

model Application {
  id             String           @id @default(uuid())
  candidateId    String
  candidate      Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage          ApplicationStage @default(APPLIED)
  matchScore     Int?
  resumeUrl      String?
  resumeFileName String?
  resumeFileSize Int?
  resumeMimeType String?          @default("application/pdf")
  notes          String?
  orderIndex     Int              @default(0)
  interviews     Interview[]
  emailLogs      EmailLog[]
  activityLogs   ActivityLog[]
  createdAt      DateTime         @default(now())
  updatedAt      temporal.updatedAt()

  @@unique([candidateId, jobId])
  @@index([jobId, stage])
  @@index([candidateId])
}

model Interview {
  id             String      @id @default(uuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  date           String
  time           String
  type           InterviewType   @default(TECHNICAL)
  format         InterviewFormat @default(MEET)
  linkOrLocation String
  interviewer    String
  round          Int         @default(1)
  scorecard      String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      temporal.updatedAt()

  @@index([applicationId])
}

model EmailTemplate {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  type           EmailTemplateType
  name           String
  subject        String
  body           String
  enabled        Boolean           @default(true)
  variables      String?
  createdAt      DateTime          @default(now())
  updatedAt      temporal.updatedAt()

  @@unique([organizationId, type])
}

model EmailSetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  provider       String       @default("SIMULATED")
  fromName       String       @default("Recruitment Team")
  fromEmail      String       @default("careers@workspace.com")
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String?
  smtpPass       String?
  smtpSecure     Boolean      @default(true)
  resendApiKey   String?
  sendgridApiKey String?
  createdAt      DateTime     @default(now())
  updatedAt      temporal.updatedAt()
}

model EmailLog {
  id             String              @id @default(uuid())
  scope          EmailScope          @default(ORGANIZATION)
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  candidateId    String?
  candidate      Candidate?          @relation(fields: [candidateId], references: [id])
  applicationId  String?
  application    Application?        @relation(fields: [applicationId], references: [id])
  senderId       String?
  senderName     String
  senderEmail    String
  recipientEmail String
  recipientName  String
  templateType   EmailTemplateType   @default(CUSTOM)
  subject        String
  body           String
  status         EmailDeliveryStatus @default(SENT)
  errorMessage   String?
  sentAt         DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId, createdAt])
  @@index([scope, createdAt])
}

model ActivityLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type           ActivityType
  title          String
  description    String
  actorId        String?
  actorName      String
  actorRole      String?
  metadata       String?
  createdAt      DateTime     @default(now())
  updatedAt      temporal.updatedAt()

  @@index([organizationId, createdAt])
  @@index([candidateId])
}

model CandidateDocument {
  id             String       @id @default(uuid())
  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  url            String
  size           Int?
  mimeType       String?      @default("application/pdf")
  type           String?      @default("Resume")
  createdAt      DateTime     @default(now())
  updatedAt      temporal.updatedAt()

  @@index([candidateId])
  @@index([organizationId])
}


