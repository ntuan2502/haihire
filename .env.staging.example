# ==============================================================================
# HAIHIRE PLATFORM - LOCAL STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.staging` for local Docker staging builds (`:8081`).
# NEVER commit `.env.staging` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & GATEWAY PORT
# ------------------------------------------------------------------------------
NODE_ENV=production
GATEWAY_PORT=8081

# ------------------------------------------------------------------------------
# 2. POSTGRESQL STAGING DATABASE
# ------------------------------------------------------------------------------
POSTGRES_USER=haihire_staging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_STAGING_DB_PASSWORD
POSTGRES_DB=haihire_staging

# ------------------------------------------------------------------------------
# 3. VALKEY / REDIS STAGING CACHE & QUEUE
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD="CHANGE_ME_STRONG_STAGING_REDIS_PASSWORD"

# ------------------------------------------------------------------------------
# 4. MINIO STAGING S3 OBJECT STORAGE
# ------------------------------------------------------------------------------
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="CHANGE_ME_STAGING_MINIO_ACCESS_KEY"
MINIO_SECRET_KEY="CHANGE_ME_STAGING_MINIO_SECRET_KEY"
MINIO_BUCKET_NAME="haihire-staging-resumes"

# ------------------------------------------------------------------------------
# 5. SECURITY & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_ME_MIN_32_CHAR_STAGING_JWT_SECRET"
ENCRYPTION_SECRET="CHANGE_ME_MIN_32_CHAR_STAGING_ENCRYPTION_SECRET"
METRICS_TOKEN="CHANGE_ME_MIN_32_CHAR_STAGING_METRICS_TOKEN"

# ------------------------------------------------------------------------------
# 6. PUBLIC ORIGIN & SYSTEM EMAIL (SMTP)
# ------------------------------------------------------------------------------
FRONTEND_URL="http://localhost:8081"
SYSTEM_EMAIL_PROVIDER="SMTP"
SYSTEM_EMAIL_FROM_NAME="HaiHire Staging"
SYSTEM_EMAIL_FROM_EMAIL="noreply@example.com"
SYSTEM_EMAIL_SMTP_HOST="smtp.example.com"
SYSTEM_EMAIL_SMTP_PORT=587
SYSTEM_EMAIL_SMTP_USER=""
SYSTEM_EMAIL_SMTP_PASS=""

# ==============================================================================
# OPTIONAL OVERRIDES (Uncomment in `.env.staging` only when needed)
# ==============================================================================
# BACKEND_PORT=3001
# FRONTEND_PORT=3000
# DATABASE_URL=""
# INTERNAL_API_URL="http://api:3001"
# NEXT_PUBLIC_API_URL=""
# MINIO_PUBLIC_URL=""
# SYSTEM_EMAIL_RESEND_API_KEY=""
# SYSTEM_EMAIL_SENDGRID_API_KEY=""
# WEBHOOK_PROVIDER=""
# WEBHOOK_URL=""
# WEBHOOK_SECRET_TOKEN=""
# WEBHOOK_CHAT_ID=""
# AI_ALLOWED_INTERNAL_HOSTS=""
