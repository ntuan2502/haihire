// use prisma-next

enum Role {
  ADMIN
  MEMBER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Organization {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  ownerId     String?
  users       User[]
  jobs        Job[]
  candidates  Candidate[]
  inviteLinks InviteLink[]
  members     OrganizationMember[]
  createdAt   DateTime             @default(now())
  updatedAt   temporal.updatedAt()
}

model User {
  id             String               @id @default(uuid())
  email          String               @unique
  name           String
  password       String?
  avatarUrl      String?
  role           Role                 @default(MEMBER)
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  jobs           Job[]
  inviteLinks    InviteLink[]
  memberships    OrganizationMember[]
  createdAt      DateTime             @default(now())
  updatedAt      temporal.updatedAt()
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      temporal.updatedAt()
}

model InviteLink {
  id             String       @id @default(uuid())
  token          String       @unique
  role           String       @default("MEMBER")
  expiresAt      DateTime?
  maxUses        Int?
  usesCount      Int          @default(0)
  status         String       @default("active")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      temporal.updatedAt()
}

model Job {
  id              String        @id @default(uuid())
  title           String
  department      String
  location        String
  postalCode      String?
  experienceLevel String?
  workplace       String?
  type            JobType       @default(FULL_TIME)
  description     String
  requirements    String?
  salaryRange     String?
  status          JobStatus     @default(PUBLISHED)
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  applications    Application[]
  createdAt       DateTime      @default(now())
  updatedAt       temporal.updatedAt()
}

model Candidate {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  firstName      String?
  lastName       String?
  gender         String?
  dateOfBirth    DateTime?
  email          String
  phone          String?
  notes          String?
  resumeUrl      String?
  resumeFileName String?
  resumeFileSize Int?
  resumeMimeType String?       @default("application/pdf")
  applications   Application[]
  createdAt      DateTime      @default(now())
  updatedAt      temporal.updatedAt()

  @@unique([organizationId, email])
}

model Application {
  id             String           @id @default(uuid())
  candidateId    String
  candidate      Candidate        @relation(fields: [candidateId], references: [id])
  jobId          String
  job            Job              @relation(fields: [jobId], references: [id])
  stage          ApplicationStage @default(APPLIED)
  matchScore     Int?
  resumeUrl      String?
  resumeFileName String?
  resumeFileSize Int?
  resumeMimeType String?          @default("application/pdf")
  notes          String?
  orderIndex     Int              @default(0)
  interviews     Interview[]
  createdAt      DateTime         @default(now())
  updatedAt      temporal.updatedAt()

  @@unique([candidateId, jobId])
}

model Interview {
  id             String      @id @default(uuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id])
  date           String
  time           String
  type           String
  format         String      @default("MEET")
  linkOrLocation String
  interviewer    String
  round          Int         @default(1)
  scorecard      String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      temporal.updatedAt()
}


