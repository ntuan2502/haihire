# ==============================================================================
# HAIHIRE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Single Source of Truth for Local Dev, Docker Compose, and CI Environments.
# Copy this file to `.env` and customize values for your local environment.
#
# DO NOT edit .env.production.example when working on local dev.
# For production deployment, use `.env.production.example` as template.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & PORTS
# ------------------------------------------------------------------------------
# Consumed by: Backend (NestJS), Frontend (Next.js), Docker Compose
NODE_ENV=development
PORT=3001
BACKEND_PORT=3001
FRONTEND_PORT=3000
BACKEND_HOST=localhost
MINIO_HOST=localhost

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE & PRISMA ORM
# ------------------------------------------------------------------------------
# Consumed by: Backend, Prisma CLI, Docker Compose
# Note: DATABASE_URL must be constructed from POSTGRES_* variables.
#       Both individual params AND full URL are maintained for flexibility.
POSTGRES_USER=haihire_user
POSTGRES_PASSWORD=haihire_password
POSTGRES_DB=haihire_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://haihire_user:haihire_password@localhost:5432/haihire_db?schema=public"

# ------------------------------------------------------------------------------
# 3. VALKEY / REDIS DISTRIBUTED CACHE & QUEUE
# ------------------------------------------------------------------------------
# Consumed by: Backend, Docker Compose
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# 4. MINIO S3 OBJECT STORAGE
# ------------------------------------------------------------------------------
# Consumed by: Backend, Frontend (NEXT_PUBLIC_MINIO_URL), Docker Compose
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="haihire-resumes"
MINIO_PUBLIC_URL="http://localhost:9000"

# ------------------------------------------------------------------------------
# 5. SECURITY & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# Consumed by: Backend, Frontend demo login, Seed scripts
# Generate secure values:
#   openssl rand -base64 32
JWT_SECRET="haihire-platform-dev-jwt-secret-key-2026"
ENCRYPTION_SECRET="haihire-platform-dev-encryption-key-32-chars-2026"
DEMO_SEED_PASSWORD="dev-seed-password-2026"
NEXT_PUBLIC_DEMO_SEED_PASSWORD="dev-seed-password-2026"
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
SEED_DEMO_ON_BOOT=false

# ------------------------------------------------------------------------------
# 6. NETWORKING, CORS & API ENDPOINTS
# ------------------------------------------------------------------------------
# Consumed by: Backend (FRONTEND_URL), Frontend (INTERNAL_API_URL, NEXT_PUBLIC_*)
FRONTEND_URL="http://localhost:3000"
FRONTEND_API_URL="http://localhost:3001"
INTERNAL_API_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_MINIO_URL="/haihire-resumes"

# ------------------------------------------------------------------------------
# 7. CI / RELEASE METADATA
# ------------------------------------------------------------------------------
# Consumed by: Build scripts and local testing
GITHUB_REPOSITORY_OWNER="ntuan2502"
IMAGE_TAG="v0.3.0"

# ------------------------------------------------------------------------------
# 8. SYSTEM EMAIL DISPATCH
# ------------------------------------------------------------------------------
# Consumed by: Backend only
SYSTEM_EMAIL_PROVIDER="SIMULATED"
SYSTEM_EMAIL_FROM_NAME="HaiHire Platform"
SYSTEM_EMAIL_FROM_EMAIL="noreply@haihire.internal"
SYSTEM_EMAIL_SMTP_HOST=""
SYSTEM_EMAIL_SMTP_PORT=587
SYSTEM_EMAIL_SMTP_USER=""
SYSTEM_EMAIL_SMTP_PASS=""
SYSTEM_EMAIL_RESEND_API_KEY=""
SYSTEM_EMAIL_SENDGRID_API_KEY=""

# ------------------------------------------------------------------------------
# 9. MULTI-CHANNEL WEBHOOK NOTIFICATIONS
# ------------------------------------------------------------------------------
# Consumed by: Backend only (webhook-settings module). NOT used by frontend.
# Global fallback; per-org settings override these values.
WEBHOOK_PROVIDER=""
WEBHOOK_URL=""
WEBHOOK_SECRET_TOKEN=""
WEBHOOK_CHAT_ID=""

# ------------------------------------------------------------------------------
# 10. PROMETHEUS PUSHGATEWAY
# ------------------------------------------------------------------------------
# Consumed by: Cron scripts, Docker Compose. NOT used by frontend.
PUSHGATEWAY_PORT=9091
PUSHGATEWAY_URL="http://pushgateway:9091"

# ------------------------------------------------------------------------------
# 11. AUTOMATED BACKUP SCRIPT CONFIGURATION
# ------------------------------------------------------------------------------
# Consumed by: scripts/backup-production.ts
POSTGRES_HOST=localhost
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=7
POSTGRES_CONTAINER="haihire-postgres"
MINIO_CONTAINER="haihire-minio"
