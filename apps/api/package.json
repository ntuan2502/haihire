{
  "name": "api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch --watch-path=src src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --packages=external --alias:@haihire/shared=../../packages/shared/src/index.ts",
    "start": "node dist/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate deploy --schema src/prisma/schema.prisma",
    "db:update": "prisma db push --schema src/prisma/schema.prisma",
    "db:seed": "node --import tsx src/prisma/seed.ts",
    "db:verify": "prisma validate --schema src/prisma/schema.prisma",
    "db:status": "prisma migrate status --schema src/prisma/schema.prisma",
    "db:generate": "prisma generate --schema src/prisma/schema.prisma"
  },
  "dependencies": {
    "@haihire/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "globals": "^17.14.0",
    "prisma": "7.10.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1",
    "vitest": "catalog:"
  }
}
