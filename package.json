{
  "name": "haihire-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter api run dev",
    "dev:web": "pnpm --filter web run dev",
    "start": "turbo run start",
    "start:api": "pnpm --filter api run start",
    "start:web": "pnpm --filter web run start",
    "build": "turbo run build",
    "build:api": "pnpm --filter api run build",
    "build:web": "pnpm --filter web run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "lint:env-sync": "tsx scripts/check-env-sync.ts",
    "lint:i18n": "pnpm --filter web run lint:i18n",
    "lint:dtopipe": "node --no-warnings --experimental-strip-types scripts/check-dtopipe-coverage.ts",
    "lint:error-i18n": "tsx scripts/check-error-code-i18n.ts",
    "lint:api-contract": "tsx scripts/check-api-contract-coverage.ts",
    "lint:prometheus-rules": "tsx scripts/check-prometheus-rules.ts",
    "lint:tenant-scope": "tsx scripts/check-tenant-scoping.ts",
    "lint:doc-links": "tsx scripts/verify-doc-links.ts",
    "lint:doc-sync": "tsx scripts/check-doc-sync.ts",
    "lint:nextjs-conventions": "tsx scripts/check-nextjs-conventions.ts",
    "lint:github-action-versions": "tsx scripts/check-github-action-versions.ts",
    "docs:stats": "tsx scripts/generate-docs-stats.ts",
    "docs:stats:write": "tsx scripts/generate-docs-stats.ts --write",
    "check:prod-email-provider": "tsx scripts/check-prod-email-provider.ts",
    "check:all": "tsx scripts/check-all.ts",
    "check:all:fast": "tsx scripts/check-all.ts --fast",
    "check:all:e2e": "tsx scripts/check-all.ts --e2e",
    "test": "turbo run test",
    "test:api": "pnpm --filter api run test",
    "test:web": "pnpm --filter web run test",
    "test:coverage": "pnpm --filter api --filter web run test --coverage",
    "test:diff": "node --no-warnings --experimental-strip-types scripts/check-test-count.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:setup": "pnpm --filter api run db:update && pnpm --filter api run db:seed",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:update": "pnpm --filter api run db:update",
    "db:seed": "pnpm --filter api run db:seed",
    "db:verify": "pnpm --filter api run db:verify",
    "db:status": "pnpm --filter api run db:status",
    "db:generate": "pnpm --filter api run db:generate",
    "db:backup": "tsx scripts/backup-production.ts",
    "docker:infra:up": "docker compose up -d",
    "docker:infra:down": "docker compose down",
    "docker:infra:logs": "docker compose logs -f",
    "docker:prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "docker:prod:config": "docker compose --env-file .env.production -f docker-compose.prod.yml config",
    "version:sync": "tsx scripts/sync-version.ts",
    "version:bump": "tsx scripts/bump-version.ts",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm lint && pnpm typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.0",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.11.10",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.18.0"
}
