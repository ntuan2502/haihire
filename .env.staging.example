# ==============================================================================
# HAIHIRE PLATFORM - STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.staging` on your staging VPS and customize secrets.
# NEVER commit `.env.staging` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONTAINER REGISTRY & RELEASE TAG
# ------------------------------------------------------------------------------
GITHUB_REPOSITORY_OWNER="ntuan2502"
IMAGE_TAG="staging"

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & PORTS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
BACKEND_PORT=3001
FRONTEND_PORT=3000
GATEWAY_PORT=8080
BACKEND_HOST=api
MINIO_HOST=minio

# ------------------------------------------------------------------------------
# 3. POSTGRESQL STAGING DATABASE
# ------------------------------------------------------------------------------
POSTGRES_USER=haihire_staging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_STAGING_DB_PASSWORD
POSTGRES_DB=haihire_staging
POSTGRES_PORT=5432
DATABASE_URL="postgresql://haihire_staging:CHANGE_ME_STRONG_STAGING_DB_PASSWORD@postgres:5432/haihire_staging?schema=public"

# ------------------------------------------------------------------------------
# 4. VALKEY / REDIS STAGING CACHE & QUEUE
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD="CHANGE_ME_STRONG_STAGING_REDIS_PASSWORD"

# ------------------------------------------------------------------------------
# 5. MINIO STAGING S3 OBJECT STORAGE
# ------------------------------------------------------------------------------
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="CHANGE_ME_STAGING_MINIO_ACCESS_KEY"
MINIO_SECRET_KEY="CHANGE_ME_STAGING_MINIO_SECRET_KEY"
MINIO_BUCKET_NAME="haihire-staging-resumes"
MINIO_PUBLIC_URL="https://staging.example.com"

# ------------------------------------------------------------------------------
# 6. SECURITY & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_ME_MIN_32_CHAR_STAGING_JWT_SECRET"
ENCRYPTION_SECRET="CHANGE_ME_MIN_32_CHAR_STAGING_ENCRYPTION_SECRET"
DEMO_SEED_PASSWORD="CHANGE_ME_NOT_USED_IN_STAGING"
NEXT_PUBLIC_DEMO_SEED_PASSWORD=""
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
SEED_DEMO_ON_BOOT=false

# ------------------------------------------------------------------------------
# 7. NETWORKING & ENDPOINTS (Two-Layer Nginx -> Caddy Same-Origin Routing)
# ------------------------------------------------------------------------------
FRONTEND_URL="https://staging.example.com"
FRONTEND_API_URL=""
INTERNAL_API_URL="http://api:3001"
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_MINIO_URL="/haihire-staging-resumes"

# ------------------------------------------------------------------------------
# 8. SYSTEM EMAIL DISPATCH (SMTP)
# ------------------------------------------------------------------------------
SYSTEM_EMAIL_PROVIDER="SMTP"
SYSTEM_EMAIL_FROM_NAME="HaiHire Staging"
SYSTEM_EMAIL_FROM_EMAIL="noreply@example.com"
SYSTEM_EMAIL_SMTP_HOST="smtp.example.com"
SYSTEM_EMAIL_SMTP_PORT=587
SYSTEM_EMAIL_SMTP_USER=""
SYSTEM_EMAIL_SMTP_PASS=""
SYSTEM_EMAIL_RESEND_API_KEY=""
SYSTEM_EMAIL_SENDGRID_API_KEY=""

# ------------------------------------------------------------------------------
# 9. MULTI-CHANNEL WEBHOOKS & METRICS
# ------------------------------------------------------------------------------
WEBHOOK_PROVIDER=""
WEBHOOK_URL=""
WEBHOOK_SECRET_TOKEN=""
WEBHOOK_CHAT_ID=""
PUSHGATEWAY_PORT=9091
PUSHGATEWAY_URL="http://pushgateway:9091"
METRICS_TOKEN="CHANGE_ME_MIN_32_CHAR_STAGING_METRICS_TOKEN"
