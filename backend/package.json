{
  "name": "backend",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch --watch-path=src src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --packages=external --alias:@haihire/shared=../packages/shared/src/index.ts",
    "start": "node dist/server.mjs",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:update": "prisma db update",
    "db:seed": "node --import tsx src/prisma/seed.ts",
    "db:verify": "prisma db verify",
    "db:status": "prisma migration status",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@haihire/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/composer": "0.29.1",
    "@prisma/composer-prisma-cloud": "0.29.1",
    "@prisma/orm-postgres": "8.0.0-rc.13",
    "alchemy": "2.0.0-beta.79",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.14",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.7",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "nodemailer": "^10.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prisma": "8.0.0-rc.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "version": "0.1.4"
}
