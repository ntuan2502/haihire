# Server Port (Binds to 0.0.0.0 for LAN access)
PORT=3001

# PostgreSQL Database Connection (Prisma 8)
# Use 'localhost' when running NestJS directly on host machine, or 'postgres' when running inside Docker
DATABASE_URL="postgresql://ats_user:ats_password@localhost:5432/ats_db?schema=public"

# MinIO S3 Object Storage Configuration
# Use 'localhost' when running NestJS directly on host machine, or 'minio' when running inside Docker
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="ats-resumes"
MINIO_PUBLIC_URL="http://localhost:9000"

# CORS Configuration
FRONTEND_URL="http://localhost:3000"

# Security Secrets (Must be changed in production)
JWT_SECRET="ats-platform-dev-jwt-secret-key-2026"
ENCRYPTION_SECRET="ats-platform-dev-encryption-key-32-chars-2026"
